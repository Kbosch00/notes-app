// use prisma-next

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}